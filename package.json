{
  "name": "project-doc-reference-rag",
  "version": "0.2.1",
  "description": "Local RAG over per-project markdown docs. Embedded LanceDB store + Ollama embeddings, exposed as CLI scripts and (later) an MCP server.",
  "type": "module",
  "bin": {
    "project-docs": "./dist/bin/project-docs.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "cli": "tsx bin/project-docs.ts",
    "ingest": "tsx bin/project-docs.ts ingest",
    "prune": "tsx bin/project-docs.ts prune",
    "query": "tsx bin/project-docs.ts query",
    "projects": "tsx bin/project-docs.ts projects",
    "docs": "tsx bin/project-docs.ts docs",
    "mcp": "tsx bin/project-docs.ts mcp",
    "smoke": "tsx scripts/smoke-test.ts",
    "build": "tsc",
    "postbuild": "node -e \"require('fs').chmodSync('dist/bin/project-docs.js', 0o755)\"",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@lancedb/lancedb": "^0.30.0",
    "@modelcontextprotocol/sdk": "^1.20.0",
    "ignore": "^7.0.6",
    "mdast-util-to-string": "^4.0.0",
    "remark-mdx": "^3.1.1",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "yargs": "^18.0.0",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/mdast": "^4.0.4",
    "@types/node": "^24.13.3",
    "@types/yargs": "^17.0.33",
    "tsx": "^4.20.6",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "fsevents@2.3.3": true,
    "esbuild@0.28.1": true
  }
}
